# Copy to .env and fill in. .env is never committed.

# PostgreSQL (compose)
POSTGRES_USER=predictor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=predictor

# Full connection string; overrides the host/port/name in config/settings.yaml.
# Inside compose the services get it automatically; this value is for host tooling
# (alembic, pytest) talking to the published port.
DATABASE_URL=postgresql://predictor:change-me@127.0.0.1:5432/predictor

# Any settings.yaml value can be overridden as PREDICTOR_<SECTION>__<KEY>
PREDICTOR_DATABASE__PASSWORD=change-me
PREDICTOR_MLFLOW__TRACKING_URI=http://127.0.0.1:5000

# Bearer token for POST /admin/* (phase 7)
PREDICTOR_API__ADMIN_TOKEN=change-me
